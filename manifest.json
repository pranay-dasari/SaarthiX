{
  "manifest_version": 3,
  "name": "SaarthiX",
  "version": "0.1.0",
  "description": "The entire web into a multilingual voice assistant for India's next billion internet users.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/scraper.js", "src/captions.js", "src/kb.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html"
  }
}
